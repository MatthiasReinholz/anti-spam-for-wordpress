msgid "Verified"
msgstr "Potwierdzono"

msgid "Verifying..."
msgstr "Sprawdzanie..."

msgid "Verifying... please wait."
msgstr "Sprawdzanie... poczekaj chwilę."

msgid "This form requires JavaScript."
msgstr "Ten formularz wymaga JavaScript."

