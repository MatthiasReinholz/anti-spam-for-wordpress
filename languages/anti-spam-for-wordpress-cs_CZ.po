msgid "Verification failed. Try again later."
msgstr "Ověření se nezdařilo. Zkuste to znovu později."

msgid "Protected by Anti Spam for WordPress"
msgstr "Chráněno pomocí Anti Spam for WordPress"

msgid "To protect your data, we’re verifying that you are a human."
msgstr "Abychom ochránili vaše údaje, ověřujeme, že jste člověk."

msgid "I'm not a robot"
msgstr "Nejsem robot"

msgid "Privacy"
msgstr "Soukromí"

msgid "Try again"
msgstr "Zkusit znovu"

msgid "Please verify before submitting."
msgstr "Před odesláním formuláře dokončete ověření."

msgid "Verified"
msgstr "Ověřeno"

msgid "Verifying..."
msgstr "Ověřování..."

msgid "Verifying... please wait."
msgstr "Ověřování... čekejte prosím."

msgid "This form requires JavaScript."
msgstr "Tento formulář vyžaduje JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %ss..."
msgstr "Počkejte prosím %s s..."
