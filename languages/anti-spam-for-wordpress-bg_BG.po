msgid "Verification failed. Try again later."
msgstr "Проверката е неуспешна. Опитайте отново по-късно."

msgid "Protected by Anti Spam for WordPress"
msgstr "Защитено от Anti Spam for WordPress"

msgid "To protect your data, we’re verifying that you are a human."
msgstr "За да защитим данните ви, проверяваме дали сте човек."

msgid "I'm not a robot"
msgstr "Не съм робот"

msgid "Privacy"
msgstr "Поверителност"

msgid "Try again"
msgstr "Опитайте отново"

msgid "Please verify before submitting."
msgstr "Моля, преминете проверката, преди да изпратите формуляра."

msgid "Verified"
msgstr "Потвърдено"

msgid "Verifying..."
msgstr "Проверка..."

msgid "Verifying... please wait."
msgstr "Проверка... моля, изчакайте."

msgid "This form requires JavaScript."
msgstr "Този формуляр изисква JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %ss..."
msgstr "Моля, изчакайте %s секунди..."
