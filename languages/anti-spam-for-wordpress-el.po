msgid "Verification failed. Try again later."
msgstr "Η επαλήθευση απέτυχε. Δοκίμασε ξανά αργότερα."

msgid "Protected by Anti Spam for WordPress"
msgstr "Προστασία από το Anti Spam for WordPress"

msgid "This check helps prevent spam."
msgstr "Αυτός ο έλεγχος βοηθά στην αποτροπή ανεπιθύμητων μηνυμάτων."

msgid "I'm not a robot"
msgstr "Δεν είμαι ρομπότ"

msgid "Privacy"
msgstr "Απόρρητο"

msgid "Try again"
msgstr "Δοκίμασε ξανά"

msgid "Please verify before submitting."
msgstr "Επιβεβαίωσε ότι δεν είσαι ρομπότ πριν στείλεις τη φόρμα."

msgid "Verified"
msgstr "Επιβεβαιώθηκε"

msgid "Verifying..."
msgstr "Έλεγχος..."

msgid "Verifying... please wait."
msgstr "Έλεγχος... περίμενε λίγο."

msgid "This form requires JavaScript."
msgstr "Αυτή η φόρμα χρειάζεται JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %s s..."
msgstr "Περίμενε %s δευτ..."
