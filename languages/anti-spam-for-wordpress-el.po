msgid "Verification failed. Try again later."
msgstr "Η επαλήθευση απέτυχε. Δοκιμάστε ξανά αργότερα."

msgid "Protected by Anti Spam for WordPress"
msgstr "Προστασία από το Anti Spam for WordPress"

msgid "To protect your data, we’re verifying that you are a human."
msgstr "Για να προστατεύσουμε τα δεδομένα σας, επαληθεύουμε ότι είστε άνθρωπος."

msgid "I'm not a robot"
msgstr "Δεν είμαι ρομπότ"

msgid "Privacy"
msgstr "Απόρρητο"

msgid "Try again"
msgstr "Δοκιμάστε ξανά"

msgid "Please verify before submitting."
msgstr "Ολοκληρώστε την επαλήθευση πριν υποβάλετε τη φόρμα."

msgid "Verified"
msgstr "Επαληθεύτηκε"

msgid "Verifying..."
msgstr "Επαλήθευση..."

msgid "Verifying... please wait."
msgstr "Επαλήθευση... παρακαλώ περιμένετε."

msgid "This form requires JavaScript."
msgstr "Αυτή η φόρμα απαιτεί JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %ss..."
msgstr "Περιμένετε %s δευτερόλεπτα..."
