msgid "I'm not a robot"
msgstr "Jag är inte en robot"

msgid "Privacy"
msgstr "Integritet"

msgid "Try again"
msgstr "Försök igen"

msgid "Please verify before submitting."
msgstr "Slutför verifieringen innan du skickar formuläret."

msgid "Verified"
msgstr "Verifierad"

msgid "Verifying..."
msgstr "Verifierar..."

msgid "Verifying... please wait."
msgstr "Verifierar... vänta."

msgid "This form requires JavaScript."
msgstr "Det här formuläret kräver JavaScript."

