msgid "Verification failed. Try again later."
msgstr "Überprüfung fehlgeschlagen. Bitte versuchen Sie es später erneut."

msgid "Protected by Anti Spam for WordPress"
msgstr "Geschützt durch Anti Spam for WordPress"

msgid "To protect your data, we’re verifying that you are a human."
msgstr "Zum Schutz Ihrer Daten überprüfen wir, ob Sie ein Mensch sind."

msgid "I'm not a robot"
msgstr "Ich bin kein Roboter"

msgid "Privacy"
msgstr "Datenschutz"

msgid "Try again"
msgstr "Erneut versuchen"

msgid "Please verify before submitting."
msgstr "Bitte führen Sie vor dem Absenden die Überprüfung durch."

msgid "Verified"
msgstr "Verifiziert"

msgid "Verifying..."
msgstr "Überprüfung läuft..."

msgid "Verifying... please wait."
msgstr "Überprüfung läuft... bitte warten."

msgid "This form requires JavaScript."
msgstr "Dieses Formular erfordert JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %ss..."
msgstr "Bitte warten Sie %s Sekunden..."
