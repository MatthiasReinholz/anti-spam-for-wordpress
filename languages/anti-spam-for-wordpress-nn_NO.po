msgid "Verification failed. Try again later."
msgstr "Stadfestinga mislukkast. Prøv igjen seinare."

msgid "Protected by Anti Spam for WordPress"
msgstr "Verna av Anti Spam for WordPress"

msgid "To protect your data, we’re verifying that you are a human."
msgstr "For å verne opplysningane dine kontrollerer vi at du er eit menneske."

msgid "I'm not a robot"
msgstr "Eg er ikkje ein robot"

msgid "Privacy"
msgstr "Personvern"

msgid "Try again"
msgstr "Prøv igjen"

msgid "Please verify before submitting."
msgstr "Fullfør stadfestinga før du sender inn skjemaet."

msgid "Verified"
msgstr "Stadfesta"

msgid "Verifying..."
msgstr "Stadfestar..."

msgid "Verifying... please wait."
msgstr "Stadfestar... vent litt."

msgid "This form requires JavaScript."
msgstr "Dette skjemaet krev JavaScript."

