msgid "I'm not a robot"
msgstr "Je ne suis pas un robot"

msgid "Privacy"
msgstr "Confidentialité"

msgid "Try again"
msgstr "Réessayer"

msgid "Please verify before submitting."
msgstr "Veuillez effectuer la vérification avant d’envoyer le formulaire."

msgid "Verified"
msgstr "Vérifié"

msgid "Verifying..."
msgstr "Vérification en cours..."

msgid "Verifying... please wait."
msgstr "Vérification en cours... veuillez patienter."

msgid "This form requires JavaScript."
msgstr "Ce formulaire nécessite JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %ss..."
msgstr "Veuillez patienter %s secondes..."
