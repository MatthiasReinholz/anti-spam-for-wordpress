msgid "Verification failed. Try again later."
msgstr "Bekreftelsen mislyktes. Prøv igjen senere."

msgid "Protected by Anti Spam for WordPress"
msgstr "Beskyttet av Anti Spam for WordPress"

msgid "To protect your data, we’re verifying that you are a human."
msgstr "For å beskytte opplysningene dine kontrollerer vi at du er et menneske."

msgid "I'm not a robot"
msgstr "Jeg er ikke en robot"

msgid "Privacy"
msgstr "Personvern"

msgid "Try again"
msgstr "Prøv igjen"

msgid "Please verify before submitting."
msgstr "Fullfør bekreftelsen før du sender inn skjemaet."

msgid "Verified"
msgstr "Bekreftet"

msgid "Verifying..."
msgstr "Bekrefter..."

msgid "Verifying... please wait."
msgstr "Bekrefter... vennligst vent."

msgid "This form requires JavaScript."
msgstr "Dette skjemaet krever JavaScript."

#. translators: %s: number of seconds remaining before the form can be submitted.
#, php-format
msgid "Please wait %ss..."
msgstr "Vennligst vent %s sekunder..."
