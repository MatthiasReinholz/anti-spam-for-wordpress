msgid "Please verify before submitting."
msgstr "Voltooi de verificatie voordat je het formulier verstuurt."

msgid "Verified"
msgstr "Geverifieerd"

msgid "Verifying..."
msgstr "Bezig met verifiëren..."

msgid "Verifying... please wait."
msgstr "Bezig met verifiëren... even geduld."

msgid "This form requires JavaScript."
msgstr "Dit formulier vereist JavaScript."

